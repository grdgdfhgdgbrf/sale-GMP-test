async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    text = update.message.text
    
    # Обработка команд /complete_X
    if text.startswith("/complete_"):
        try:
            task_id = int(text.split("_")[1])
            if db.complete_task(user_id, task_id):
                await update.message.reply_text(
                    "✅ <b>Задание выполнено!</b>\n\n"
                    "Монеты начислены на ваш баланс!",
                    reply_markup=get_main_keyboard(),
                    parse_mode="HTML"
                )
            else:
                await update.message.reply_text(
                    "❌ <b>Ошибка!</b>\n\n"
                    "Вы уже выполнили это задание или оно не существует.",
                    reply_markup=get_main_keyboard(),
                    parse_mode="HTML"
                )
        except Exception as e:
            logger.error(f"Ошибка выполнения задания: {e}")
            await update.message.reply_text(
                "❌ Ошибка при выполнении задания",
                reply_markup=get_main_keyboard()
            )
        return
    
    # Обработка админских действий
    if "admin_action" in context.user_data:
        action = context.user_data["admin_action"]
        
        if action == "add_task" and user_id in ADMIN_IDS:
            try:
                parts = text.split(" | ")
                if len(parts) != 4:
                    await update.message.reply_text(
                        "❌ Неверный формат!\n"
                        "Используйте: Название | Описание | Ссылка | Награда"
                    )
                    return
                
                title, description, channel_link, reward = parts
                reward = int(reward)
                
                task_id = db.add_task(title, description, channel_link, reward, user_id)
                if task_id:
                    await update.message.reply_text(
                        f"✅ <b>Задание создано!</b>\n\n"
                        f"ID: {task_id}\n"
                        f"Название: {title}\n"
                        f"Награда: {reward} монет",
                        reply_markup=get_admin_keyboard(),
                        parse_mode="HTML"
                    )
                else:
                    await update.message.reply_text(
                        "❌ Ошибка при создании задания",
                        reply_markup=get_admin_keyboard()
                    )
                
                context.user_data.pop("admin_action", None)
            except Exception as e:
                logger.error(f"Ошибка создания задания: {e}")
                await update.message.reply_text("❌ Ошибка при создании задания")
        
        elif action == "give_bonus" and user_id in ADMIN_IDS:
            try:
                parts = text.split(" | ")
                if len(parts) != 2:
                    await update.message.reply_text(
                        "❌ Неверный формат!\n"
                        "Используйте: ID_пользователя | Количество_монет"
                    )
                    return
                
                target_user_id = int(parts[0])
                amount = int(parts[1])
                
                db.update_coins(target_user_id, amount, f"Бонус от администратора")
                await update.message.reply_text(
                    f"✅ <b>Бонус выдан!</b>\n\n"
                    f"Пользователь: {target_user_id}\n"
                    f"Начислено: {amount} монет",
                    reply_markup=get_admin_keyboard(),
                    parse_mode="HTML"
                )
                context.user_data.pop("admin_action", None)
            except Exception as e:
                logger.error(f"Ошибка выдачи бонуса: {e}")
                await update.message.reply_text("❌ Ошибка при выдаче бонуса")

