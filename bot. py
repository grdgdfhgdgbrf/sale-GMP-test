# База данных
class Database:
    def __init__(self):
        self.conn = sqlite3.connect("bot.db", check_same_thread=False)
        self.cursor = self.conn.cursor()
        self.init_db()

    def init_db(self):
        # Таблица пользователей
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                coins INTEGER DEFAULT 0,
                referals INTEGER DEFAULT 0,
                is_admin BOOLEAN DEFAULT FALSE,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        
        # Таблица заданий
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT,
                description TEXT,
                channel_link TEXT,
                channel_id TEXT,
                reward INTEGER,
                created_by INTEGER,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                is_active BOOLEAN DEFAULT TRUE,
                task_type TEXT DEFAULT 'subscribe'
            )
        """)
        
        # Таблица выполненных заданий
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS completed_tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                task_id INTEGER,
                completed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                reward_received INTEGER,
                UNIQUE(user_id, task_id)
            )
        """)
        
        # Таблица транзакций
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                amount INTEGER,
                type TEXT,
                description TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        
        self.conn.commit()

    def add_user(self, user_id: int, username: str = None):
        try:
            self.cursor.execute(
                "INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)",
                (user_id, username)
            )
            self.conn.commit()
        except Exception as e:
            logger.error(f"Ошибка добавления пользователя: {e}")

    def get_user_coins(self, user_id: int) -> int:
        try:
            self.cursor.execute("SELECT coins FROM users WHERE user_id = ?", (user_id,))
            result = self.cursor.fetchone()
            return result[0] if result else 0
        except Exception as e:
            logger.error(f"Ошибка получения монет: {e}")
            return 0

    def update_coins(self, user_id: int, amount: int, description: str = ""):
        try:
            self.cursor.execute(
                "UPDATE users SET coins = coins + ? WHERE user_id = ?",
                (amount, user_id)
            )
            self.cursor.execute(
                "INSERT INTO transactions (user_id, amount, type, description) VALUES (?, ?, ?, ?)",
                (user_id, amount, "bonus" if amount > 0 else "spend", description)
            )
            self.conn.commit()
        except Exception as e:
            logger.error(f"Ошибка обновления монет: {e}")

    def add_task(self, title: str, description: str, channel_link: str, reward: int, created_by: int) -> int:
        try:
            self.cursor.execute("""
                INSERT INTO tasks (title, description, channel_link, reward, created_by)
                VALUES (?, ?, ?, ?, ?)
            """, (title, description, channel_link, reward, created_by))
            self.conn.commit()
            return self.cursor.lastrowid
        except Exception as e:
            logger.error(f"Ошибка добавления задания: {e}")
            return None

    def get_active_tasks(self) -> List[Dict]:
        try:
            self.cursor.execute("""
                SELECT id, title, description, channel_link, reward 
                FROM tasks 
                WHERE is_active = TRUE
                ORDER BY created_at DESC
            """)
            rows = self.cursor.fetchall()
            return [
                {
                    "id": row[0],
                    "title": row[1],
                    "description": row[2],
                    "channel_link": row[3],
                    "reward": row[4],
                }
                for row in rows
            ]
        except Exception as e:
            logger.error(f"Ошибка получения заданий: {e}")
            return []

    def complete_task(self, user_id: int, task_id: int) -> bool:
        try:
            # Проверяем, не выполнил ли пользователь уже это задание
            self.cursor.execute(
                "SELECT * FROM completed_tasks WHERE user_id = ? AND task_id = ?",
                (user_id, task_id)
            )
            if self.cursor.fetchone():
                return False

            # Получаем награду
            self.cursor.execute("SELECT reward FROM tasks WHERE id = ?", (task_id,))
            result = self.cursor.fetchone()
            if not result:
                return False
            
            reward = result[0]
            
            # Добавляем в выполненные
            self.cursor.execute(
                "INSERT INTO completed_tasks (user_id, task_id, reward_received) VALUES (?, ?, ?)",
                (user_id, task_id, reward)
            )
            
            # Начисляем монеты
            self.update_coins(user_id, reward, f"Выполнено задание #{task_id}")
            self.conn.commit()
            return True
        except Exception as e:
            logger.error(f"Ошибка выполнения задания: {e}")
            return False

    def get_user_stats(self, user_id: int) -> Dict:
        try:
            self.cursor.execute(
                "SELECT coins, referals FROM users WHERE user_id = ?",
                (user_id,)
            )
            result = self.cursor.fetchone()
            if result:
                return {"coins": result[0], "referals": result[1]}
            return {"coins": 0, "referals": 0}
        except Exception as e:
            logger.error(f"Ошибка получения статистики: {e}")
            return {"coins": 0, "referals": 0}

    def get_completed_tasks_count(self, user_id: int) -> int:
        try:
            self.cursor.execute(
                "SELECT COUNT(*) FROM completed_tasks WHERE user_id = ?",
                (user_id,)
            )
            result = self.cursor.fetchone()
            return result[0] if result else 0
        except Exception as e:
            logger.error(f"Ошибка получения количества заданий: {e}")
            return 0

    def get_total_users(self) -> int:
        try:
            self.cursor.execute("SELECT COUNT(*) FROM users")
            result = self.cursor.fetchone()
            return result[0] if result else 0
        except Exception as e:
            logger.error(f"Ошибка получения количества пользователей: {e}")
            return 0

